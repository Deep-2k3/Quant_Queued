//@version=6
indicator("LiquidityEdge | Master Reset (V21)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ========================================================================= //
// --- 1. SETTINGS ---
// ========================================================================= //
grpLE = "LIQUIDITYEDGE CORE"
swingLen   = input.int(2, "Swing Length", minval=1, group=grpLE)
invalType  = input.string("Close", "Invalidation", options=["Close", "Wick"], group=grpLE)
maxZones   = input.int(20, "Show Nearest LTF", group=grpLE)
projBars   = input.int(60, "Extend Zones (bars)", group=grpLE) 

grpDepth = "DEPTHFLOW DOMINANCE"
volDataTF  = input.timeframe("15S", "Volume Data TF", group=grpDepth)
minDom     = input.int(60, "Filter: Min Dominant %", group=grpDepth)
ctrlPct    = input.int(75, "High Control % (A+)", group=grpDepth)

grpLines = "ENTRY / STOP LINES"
slBuffer   = input.int(8, "Stop Loss Offset (ticks)", group=grpLines)
showLimit  = input.bool(true, "Show Entry Limit", group=grpLines)

grpVis = "MEMORY GATE"
histDays   = input.int(3, "Calculate Last X Days", minval=1, group=grpVis)
colSup     = input.color(color.new(#089981, 70), "Demand Color", group=grpVis)
colRes     = input.color(color.new(#F23645, 70), "Supply Color", group=grpVis)
colA       = color.new(#00E676, 0)
colB       = color.new(#FFEB3B, 0)
colTransp  = color.new(color.white, 100)

// ========================================================================= //
// --- 2. TYPES & ARRAYS ---
// ========================================================================= //
type DepthZone
    int originBar
    box bgBox
    line limitLine
    line slLine
    label volLbl
    label gradeLbl
    label deltaLbl
    bool isDemand
    float top
    float bottom
    bool isActive

var activeLTF = array.new<DepthZone>()

// ========================================================================= //
// --- 3. DATA ENGINE (FIXED SYNTAX) ---
// ========================================================================= //
isClose  = barstate.isconfirmed
isRecent = time > (timenow - (histDays * 86400000))
tickSize = syminfo.mintick

// FIX: Correct tuple assignment for security_lower_tf
[ltf_o, ltf_h, ltf_l, ltf_c, ltf_v] = request.security_lower_tf(syminfo.tickerid, volDataTF, [open, high, low, close, volume])

float buyV  = 0.0
float sellV = 0.0

if isClose and isRecent
    int _sz = na(ltf_v) ? 0 : array.size(ltf_v)
    if _sz > 0
        for i = 0 to _sz - 1
            float _v = array.get(ltf_v, i)
            if array.get(ltf_c, i) >= array.get(ltf_o, i)
                buyV += _v
            else
                sellV += _v
    else
        float r = math.max(high - low, 0.0001)
        buyV := ((close - low) / r) * volume
        sellV := volume - buyV

// ========================================================================= //
// --- 4. ZONE GEOMETRY ---
// ========================================================================= //
f_create_zone(_isDemand, _pBar, _h, _l, _o, _c, _vol, _bV, _sV) =>
    float bPct = (_bV / math.max(_vol, 1)) * 100
    float sPct = (_sV / math.max(_vol, 1)) * 100
    float domP = _isDemand ? bPct : sPct
    
    if domP >= minDom
        // MIG GEOMETRY: Body-weighted 50% High/Low Range
        float midPoint = (_h + _l) / 2
        float _top = _isDemand ? math.max(_o, _c) : _h
        float _bot = _isDemand ? _l : math.min(_o, _c)
        
        if _isDemand
            _top := math.max(midPoint, math.min(_o, _c))
        else
            _bot := math.min(midPoint, math.max(_o, _c))

        float _slP = _isDemand ? (_l - (slBuffer * tickSize)) : (_h + (slBuffer * tickSize))
        
        avgV = ta.sma(volume, 50)
        string g1 = _vol > (avgV * 1.5) ? "A+" : "B"
        string g2 = domP > ctrlPct ? "A+" : "B"
        string grade = g1 + g2 + "C"
        
        color gCol = domP > ctrlPct ? colA : colB
        string deltaTxt = "B " + str.tostring(math.round(bPct)) + "% | S " + str.tostring(math.round(sPct)) + "%"
        string vTxt = _vol >= 1000 ? str.tostring(_vol / 1000, "#.###") + "K" : str.tostring(_vol, "#")

        _r = bar_index + projBars
        _box = box.new(_pBar, _top, _r, _bot, bgcolor=_isDemand ? colSup : colRes, border_color=color.new(color.white, 90))
        _lmt = line.new(_pBar, _isDemand ? _top : _bot, _r, _isDemand ? _top : _bot, color=_isDemand ? colSup : colRes, style=line.style_dotted)
        _sl  = line.new(_pBar, _slP, _r, _slP, color=color.new(#FF5252, 60), style=line.style_dotted)
        
        _dLbl = label.new(int((_pBar+_r)/2), (_top+_bot)/2, deltaTxt, textcolor=color.new(color.white, 40), color=colTransp, style=label.style_none, size=size.small)
        _vLbl = label.new(_r, (_top+_bot)/2, vTxt + "  ", textcolor=color.new(color.white, 50), color=colTransp, style=label.style_label_right, size=size.small)
        _gLbl = label.new(_r, (_top+_bot)/2, "  " + grade, textcolor=gCol, color=colTransp, style=label.style_label_left, size=size.small)

        activeLTF.push(DepthZone.new(_pBar, _box, _lmt, _sl, _vLbl, _gLbl, _dLbl, _isDemand, _top, _bot, true))

// ========================================================================= //
// --- 5. EXECUTION ---
// ========================================================================= //
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

if isClose and isRecent
    if not na(ph)
        for i = 0 to (swingLen * 2)
            f_create_zone(false, bar_index[i], high[i], low[i], open[i], close[i], volume[i], buyV[i], sellV[i])
    if not na(pl)
        for i = 0 to (swingLen * 2)
            f_create_zone(true, bar_index[i], high[i], low[i], open[i], close[i], volume[i], buyV[i], sellV[i])

if activeLTF.size() > 0
    for i = activeLTF.size() - 1 to 0
        z = activeLTF.get(i)
        if z.isActive
            if barstate.islast
                box.set_right(z.bgBox, bar_index + projBars)
                line.set_x2(z.limitLine, bar_index + projBars)
                line.set_x2(z.slLine, bar_index + projBars)
                label.set_x(z.volLbl, bar_index + projBars)
                label.set_x(z.gradeLbl, bar_index + projBars)
                label.set_x(z.deltaLbl, int((z.originBar + (bar_index + projBars))/2))
            
            isBroken = invalType == "Close" ? (z.isDemand ? close < z.bottom : close > z.top) : (z.isDemand ? low < z.bottom : high > z.top)
            if isBroken and isClose
                z.isActive := false
                box.delete(z.bgBox), line.delete(z.limitLine), line.delete(z.slLine)
                label.delete(z.volLbl), label.delete(z.gradeLbl), label.delete(z.deltaLbl)
                activeLTF.remove(i)
