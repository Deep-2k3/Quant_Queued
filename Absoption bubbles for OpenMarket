//@lang=wrun-ts
// NQ Sniper v2: Auto UTC-5 Session + Liquidity Sweep Filter + Smart SL Clamp + Zero-Warning Scorecard

// 1. SESSION & ADAPTIVE REGIME SETTINGS
param.int("session_mode", 0, { min: 0, max: 5, label: "Session Mode (0=AUTO UTC-5, 1=Asia, 2=LDN, 3=NY AM, 4=Lunch, 5=Manual)" });
param.bool("adaptive_regime", true, { label: "Adaptive Volatility Scaling (ATR Regime)" });
param.int("utc_offset_hrs", -5, { min: -12, max: 14, label: "Exchange Timezone Offset (NY EST = -5)" });

// 2. ANTI-CHOP LOCATION & EXECUTION ENGINE
param.bool("require_sweep", true, { label: "Anti-Chop: Only Enter on Liquidity Sweep of Swing High/Low" });
param.int("swing_lookback", 10, { min: 3, max: 60, label: "Liquidity Sweep Lookback Bars (Also Manual Delta Lookback)" });
param.bool("clamp_sl_to_max", true, { label: "Cap Wide Wicks at Max SL (Instead of Skipping Trade)" });
param.int("max_past_setups", 10, { min: 1, max: 15, label: "Number of Past Setups in Scorecard (1-15)" });
param.bool("show_all_history_lines", true, { label: "Draw Entry/SL/TP Lines on Setups" });
param.int("trigger_bars", 3, { min: 1, max: 6, label: "Max Bars to Reclaim Absorption Candle" });
param.number("sl_buffer_pts", 2.5, { min: 0.5, max: 10.0, step: 0.25, label: "SL Buffer Behind Wick (Pts)" });
param.number("max_sl_pts", 20.0, { min: 5.0, max: 50.0, step: 1.0, label: "Max Allowed Stop Loss (Pts)" });
param.number("tp1_pts", 25.0, { min: 5.0, max: 100.0, step: 5.0, label: "TP1: Breakeven Trigger (Pts)" });
param.number("tp2_pts", 60.0, { min: 10.0, max: 200.0, step: 5.0, label: "TP2: Lock +TP1 Trail Trigger (Pts)" });
param.number("tp3_pts", 100.0, { min: 20.0, max: 300.0, step: 5.0, label: "TP3: Full GEX Runner Target (Pts)" });

// 3. MANUAL ABSORPTION PARAMETERS (Used when session_mode == 5)
param.number("minor_mult", 2.0, { min: 1.0, max: 10.0, step: 0.1, label: "Manual: Minor Delta Mult" });
param.number("major_mult", 3.5, { min: 1.5, max: 15.0, step: 0.1, label: "Manual: Major Delta Mult" });
param.number("max_body_pct", 0.50, { min: 0.10, max: 1.0, step: 0.05, label: "Manual: Max Body / Range" });
param.number("min_range_pts", 2.5, { min: 0.25, max: 25.0, step: 0.25, label: "Manual: Min Bar Range (Pts)" });
param.bool("require_wick_rejection", true, { label: "Require Wick Rejection (40%)" });

// INPUT FEEDS
input("close", ohlcv.close);
input("buy", trades.volume, { side: "BUY", missing: "zero" });
input("sell", trades.volume, { side: "SELL", missing: "zero" });

// ABSORPTION BUBBLES (Strictly Circles: Cyan/Green = Bullish, Orange/Red = Bearish)
output("bull_minor", scatter, overlay, { color: "#00e5ff", width: 5, description: "Minor Bullish Bid Absorption" });
output("bull_major", scatter, overlay, { color: "#00ff88", width: 9, description: "Major Bullish Bid Absorption" });
output("bear_minor", scatter, overlay, { color: "#ff9100", width: 5, description: "Minor Bearish Ask Absorption" });
output("bear_major", scatter, overlay, { color: "#ff1744", width: 9, description: "Major Bearish Ask Absorption" });

// DISTINCT SHAPES FOR ENTRIES & EXITS
output("long_entry_y", none, overlay, { legend: false });
output("short_entry_y", none, overlay, { legend: false });
output("sl_exit_y", none, overlay, { legend: false });
output("be_exit_y", none, overlay, { legend: false });
output("tp_exit_y", none, overlay, { legend: false });

render.shape("long_entry_mark", { output: "long_entry_y", shape: "triangle_up", color: "#00e676", width: 9 });
render.shape("short_entry_mark", { output: "short_entry_y", shape: "triangle_down", color: "#d500f9", width: 9 });
render.shape("sl_exit_mark", { output: "sl_exit_y", shape: "cross", color: "#ff1744", width: 8 });
render.shape("be_exit_mark", { output: "be_exit_y", shape: "diamond", color: "#00e5ff", width: 8 });
render.shape("tp_exit_mark", { output: "tp_exit_y", shape: "flag", color: "#ffd600", width: 10 });

// TRADE LEVEL LINES
output("entry_line", line, overlay, { color: "#ffffff", width: 1, description: "Setup Entry Price" });
output("sl_line", line, overlay, { color: "#ff1744", width: 2, description: "Setup Active Stop Loss (Steps to BE / TP1)" });
output("tp1_line", line, overlay, { color: "#00e5ff", width: 1, description: "Setup TP1 (+25 pts -> Lock BE)" });
output("tp2_line", line, overlay, { color: "#00e676", width: 1, description: "Setup TP2 (+60 pts -> Lock TP1)" });
output("tp3_line", line, overlay, { color: "#ffd600", width: 2, description: "Setup TP3 (+100 pts GEX Runner)" });

// ALERTS
const armed_alert = output("armed_alert", none, overlay, { legend: false });
const entry_trigger_alert = output("entry_trigger_alert", none, overlay, { legend: false });
alert("sweep_absorption_armed", { when: armed_alert, message: "Liquidity Sweep Absorption Armed on {{symbol}} at {{close}}" });
alert("reclaim_entry_triggered", { when: entry_trigger_alert, message: "Confirmed Absorption Reclaim Entry on {{symbol}} at {{close}}" });

// COMPACT HUD CELLS
string("mode_cell", { max_bytes: 28 });
string("ratio_cell", { max_bytes: 24 });
string("score_cell", { max_bytes: 48 });
string("status_cell", { max_bytes: 32 });
legend({ title: "NQ Sniper v2" });
render.legend("mode_readout", { text: "mode_cell" });
render.legend("ratio_readout", { text: "ratio_cell" });
render.legend("score_readout", { text: "score_cell" });
render.legend("status_readout", { text: "status_cell" });

// PRIMITIVE BIT-PACKED REGISTERS FOR LAST 15 SETUPS (Zero Arrays = Zero Warnings!)
// histMask: 2 bits per setup (1=Loss, 2=BE/Trail Win, 3=Full TP3 Win)
// histPtsPack: 10 bits per setup storing (signed_pts + 200) for up to 6 recent trades, plus cumulative netPts
let histMask: i64 = 0;
let histTotalCount: i32 = 0;
let cumulativeNetPts: f64 = 0.0;

// ROLLING VOLATILITY, SWING EXTREMES & DELTA BASELINES
let fastDeltaSma = new Sma(15);
let medDeltaSma = new Sma(25);
let slowDeltaSma = new Sma(35);
let customDeltaSma = new Sma(10);
let fastRangeSma = new Sma(14);
let baseRangeSma = new Sma(60);
let swingHighMax = new RunningMax(10);
let swingLowMin = new RunningMin(10);

// CONFIGURATION STATE
let sessionMode: i32 = 0;
let useAdaptive: bool = true;
let utcOffsetMins: i32 = -300;
let requireSweep: bool = true;
let clampSl: bool = true;
let maxPastSetups: i32 = 10;
let showHistoryLines: bool = true;

let manualMinor: f64 = 2.0;
let manualMajor: f64 = 3.5;
let manualBody: f64 = 0.50;
let manualMinRange: f64 = 2.5;
let requireWick: bool = true;

let triggerBarsMax: i32 = 3;
let slBufferPts: f64 = 2.5;
let maxSlPts: f64 = 20.0;
let tp1Pts: f64 = 25.0;
let tp2Pts: f64 = 60.0;
let tp3Pts: f64 = 100.0;

// Armed & Active Trade State Machine
let armedDir: i32 = 0;
let armedCount: i32 = 0;
let armedHigh: f64 = 0.0;
let armedLow: f64 = 0.0;

let tradeDir: i32 = 0;
let entryPrice: f64 = 0.0;
let slPrice: f64 = 0.0;
let tp1Price: f64 = 0.0;
let tp2Price: f64 = 0.0;
let tp3Price: f64 = 0.0;
let beLocked: bool = false;
let hitTp2: bool = false;

let modeText = new TextBuilder(28);
let ratioText = new TextBuilder(24);
let scoreText = new TextBuilder(48);
let statusText = new TextBuilder(32);

function recordSetup(code: i64, pts: f64): void {
  histMask = (histMask << 2) | (code & 3);
  if (histTotalCount < 15) {
    histTotalCount = histTotalCount + 1;
  }
  cumulativeNetPts = cumulativeNetPts + pts;
}

function getNyMinutesOfDay(timeValue: f64, offsetMins: i32): i32 {
  const totalMins = timeValue > 100000000000.0
    ? i64(Math.floor(timeValue / 60000.0))
    : i64(Math.floor(timeValue / 60.0));
  const shifted = totalMins + i64(offsetMins);
  let modMins = i32(shifted % 1440);
  if (modMins < 0) {
    modMins = modMins + 1440;
  }
  return modMins;
}

function onStart(): void {
  sessionMode = i32(p_session_mode());
  useAdaptive = pb_adaptive_regime();
  utcOffsetMins = i32(p_utc_offset_hrs()) * 60;
  requireSweep = pb_require_sweep();
  clampSl = pb_clamp_sl_to_max();
  maxPastSetups = i32(p_max_past_setups());
  showHistoryLines = pb_show_all_history_lines();
  requireWick = pb_require_wick_rejection();

  triggerBarsMax = i32(p_trigger_bars());
  slBufferPts = p_sl_buffer_pts();
  maxSlPts = p_max_sl_pts();
  tp1Pts = p_tp1_pts();
  tp2Pts = p_tp2_pts();
  tp3Pts = p_tp3_pts();

  manualMinor = p_minor_mult();
  manualMajor = p_major_mult();
  manualBody = p_max_body_pct();
  manualMinRange = p_min_range_pts();

  const swLen = i32(p_swing_lookback());
  fastDeltaSma = new Sma(15);
  medDeltaSma = new Sma(25);
  slowDeltaSma = new Sma(35);
  customDeltaSma = new Sma(swLen);
  fastRangeSma = new Sma(14);
  baseRangeSma = new Sma(60);
  swingHighMax = new RunningMax(swLen);
  swingLowMin = new RunningMin(swLen);

  armedDir = 0;
  tradeDir = 0;
  histMask = 0;
  histTotalCount = 0;
  cumulativeNetPts = 0.0;
}

function onBar(): void {
  const buyVolume = in_buy();
  const sellVolume = in_sell();
  const delta = buyVolume - sellVolume;
  const absDelta = Math.abs(delta);

  const high = bar.high();
  const low = bar.low();
  const open = bar.open();
  const close = bar.close();
  const barRange = Math.max(high - low, 0.0001);
  const bodyRatio = Math.abs(close - open) / barRange;

  const avgDeltaFast = fastDeltaSma.update(absDelta);
  const avgDeltaMed = medDeltaSma.update(absDelta);
  const avgDeltaSlow = slowDeltaSma.update(absDelta);
  const avgDeltaCustom = customDeltaSma.update(absDelta);
  const shortAtr = fastRangeSma.update(barRange);
  const longAtr = baseRangeSma.update(barRange);

  // Rolling Structural Swing Extremes (Includes current bar so low == recentLow means a new N-bar low sweep)
  const recentHigh = swingHighMax.update(high);
  const recentLow = swingLowMin.update(low);
  const tolerance = !isNaN(shortAtr) ? shortAtr * 0.25 : 1.5;
  const sweptLow = !requireSweep || (!isNaN(recentLow) && low <= recentLow + tolerance);
  const sweptHigh = !requireSweep || (!isNaN(recentHigh) && high >= recentHigh - tolerance);

  // Determine Active Session (Auto UTC-5 NY EST or Manual Override)
  let activeSessId: i32 = 2;
  if (sessionMode == 0) {
    const nyMins = getNyMinutesOfDay(f64(bar.time()), utcOffsetMins);
    if (nyMins >= 120 && nyMins < 480) {
      activeSessId = 2; // 02:00 - 08:00 EST: London
    } else if (nyMins >= 480 && nyMins < 570) {
      activeSessId = 3; // 08:00 - 09:30 EST: NY Pre-Market
    } else if (nyMins >= 570 && nyMins < 690) {
      activeSessId = 4; // 09:30 - 11:30 EST: NY AM Open
    } else if (nyMins >= 690 && nyMins < 810) {
      activeSessId = 5; // 11:30 - 13:30 EST: NY Lunch
    } else if (nyMins >= 810 && nyMins < 1020) {
      activeSessId = 6; // 13:30 - 17:00 EST: NY PM Close
    } else {
      activeSessId = 1; // 18:00 - 02:00 EST: Asia / Globex
    }
  } else if (sessionMode == 1) {
    activeSessId = 1;
  } else if (sessionMode == 2) {
    activeSessId = 2;
  } else if (sessionMode == 3) {
    activeSessId = 4;
  } else if (sessionMode == 4) {
    activeSessId = 5;
  } else {
    activeSessId = 7;
  }

  let avgDelta = avgDeltaMed;
  let minorMult = 1.8;
  let majorMult = 3.0;
  let maxBodyPct = 0.55;
  let minRangePts = 2.5;

  if (activeSessId == 1) {
    avgDelta = avgDeltaSlow;
    minorMult = 1.5;
    majorMult = 2.5;
    maxBodyPct = 0.60;
    minRangePts = 1.5;
  } else if (activeSessId == 2) {
    avgDelta = avgDeltaMed;
    minorMult = 1.8;
    majorMult = 3.0;
    maxBodyPct = 0.55;
    minRangePts = 2.25;
  } else if (activeSessId == 3) {
    avgDelta = avgDeltaMed;
    minorMult = 2.0;
    majorMult = 3.3;
    maxBodyPct = 0.50;
    minRangePts = 3.0;
  } else if (activeSessId == 4) {
    avgDelta = avgDeltaFast;
    minorMult = 2.4;
    majorMult = 4.0;
    maxBodyPct = 0.45;
    minRangePts = 5.0;
  } else if (activeSessId == 5) {
    avgDelta = avgDeltaSlow;
    minorMult = 2.2;
    majorMult = 3.5;
    maxBodyPct = 0.40;
    minRangePts = 2.0;
  } else if (activeSessId == 6) {
    avgDelta = avgDeltaMed;
    minorMult = 2.0;
    majorMult = 3.2;
    maxBodyPct = 0.50;
    minRangePts = 3.0;
  } else {
    avgDelta = avgDeltaCustom;
    minorMult = manualMinor;
    majorMult = manualMajor;
    maxBodyPct = manualBody;
    minRangePts = manualMinRange;
  }

  // Adaptive Volatility Scaling
  let volRegime: i32 = 0;
  if (useAdaptive && !isNaN(shortAtr) && !isNaN(longAtr) && longAtr > 0.0) {
    const atrRatio = shortAtr / longAtr;
    const dynamicMinRange = shortAtr * 0.60;
    if (dynamicMinRange > minRangePts) {
      minRangePts = dynamicMinRange;
    }
    if (atrRatio >= 1.25) {
      volRegime = 1;
      minorMult = minorMult * 1.12;
      majorMult = majorMult * 1.15;
      maxBodyPct = Math.max(0.35, maxBodyPct - 0.05);
    } else if (atrRatio <= 0.80) {
      volRegime = -1;
      minorMult = Math.max(1.3, minorMult * 0.90);
      majorMult = Math.max(2.2, majorMult * 0.90);
    }
  }

  const hasBaseline = !isNaN(avgDelta) && avgDelta > 0.0;
  const deltaRatio = hasBaseline ? absDelta / avgDelta : NaN;

  const bullRejection = !requireWick || (close - low) / barRange >= 0.40;
  const bearRejection = !requireWick || (high - close) / barRange >= 0.40;
  const rangeOk = barRange >= minRangePts;

  const qualifies = hasBaseline && rangeOk && deltaRatio >= minorMult && bodyRatio <= maxBodyPct;
  const bullAbsorption = qualifies && delta < 0.0 && bullRejection;
  const bearAbsorption = qualifies && delta > 0.0 && bearRejection;

  const bullMajor = bullAbsorption && deltaRatio >= majorMult;
  const bearMajor = bearAbsorption && deltaRatio >= majorMult;
  const bullMinor = bullAbsorption && !bullMajor;
  const bearMinor = bearAbsorption && !bearMajor;

  // Plot All Absorption Bubbles for Orderflow Context
  out_bull_minor(bullMinor ? low : NaN);
  out_bull_major(bullMajor ? low : NaN);
  out_bear_minor(bearMinor ? high : NaN);
  out_bear_major(bearMajor ? high : NaN);

  let firedEntryLong = false;
  let firedEntryShort = false;
  let firedSlHit = false;
  let firedBeHit = false;
  let firedTpHit = false;
  let exitMarkerPrice = NaN;

  // 1. Evaluate Active Trade Exit, TP1->BE Shift, TP2->TP1 Trail, & Opposite Major Defense
  if (tradeDir == 1) {
    if (low <= slPrice) {
      exitMarkerPrice = slPrice;
      if (beLocked) {
        firedBeHit = true;
        recordSetup(2, slPrice - entryPrice > tp1Pts * 0.5 ? tp1Pts : 2.0);
      } else {
        firedSlHit = true;
        recordSetup(1, -(entryPrice - slPrice));
      }
      tradeDir = 0;
    } else if (high >= tp3Price) {
      exitMarkerPrice = tp3Price;
      firedTpHit = true;
      recordSetup(3, tp3Pts);
      tradeDir = 0;
    } else {
      // Step SL to TP1 (+25 pts) once TP2 (+60 pts) is reached
      if (!hitTp2 && high >= tp2Price) {
        hitTp2 = true;
        slPrice = tp1Price;
        beLocked = true;
      } else if (!beLocked && high >= tp1Price) {
        slPrice = entryPrice + 2.0;
        beLocked = true;
      }
      // If an opposite Major Bearish Absorption prints while in profit above TP1, tighten SL to bar low
      if (beLocked && bearMajor && low - slBufferPts > slPrice) {
        slPrice = low - slBufferPts;
      }
    }
  } else if (tradeDir == -1) {
    if (high >= slPrice) {
      exitMarkerPrice = slPrice;
      if (beLocked) {
        firedBeHit = true;
        recordSetup(2, entryPrice - slPrice > tp1Pts * 0.5 ? tp1Pts : 2.0);
      } else {
        firedSlHit = true;
        recordSetup(1, -(slPrice - entryPrice));
      }
      tradeDir = 0;
    } else if (low <= tp3Price) {
      exitMarkerPrice = tp3Price;
      firedTpHit = true;
      recordSetup(3, tp3Pts);
      tradeDir = 0;
    } else {
      // Step SL to TP1 (+25 pts) once TP2 (+60 pts) is reached
      if (!hitTp2 && low <= tp2Price) {
        hitTp2 = true;
        slPrice = tp1Price;
        beLocked = true;
      } else if (!beLocked && low <= tp1Price) {
        slPrice = entryPrice - 2.0;
        beLocked = true;
      }
      // If an opposite Major Bullish Absorption prints while in profit below TP1, tighten SL to bar high
      if (beLocked && bullMajor && high + slBufferPts < slPrice) {
        slPrice = high + slBufferPts;
      }
    }
  }

  // 2. Evaluate Armed Setup for Reclaim Entry (With Smart 20pt SL Clamp)
  const exitedThisBar = firedSlHit || firedBeHit || firedTpHit;
  if (!exitedThisBar && tradeDir == 0 && armedDir != 0) {
    armedCount = armedCount + 1;
    if (armedDir == 1 && close > armedHigh && delta > 0.0) {
      let proposedSl = armedLow - slBufferPts;
      let riskPts = close - proposedSl;
      if (clampSl && riskPts > maxSlPts) {
        proposedSl = close - maxSlPts;
        riskPts = maxSlPts;
      }
      if (riskPts > 0.0 && riskPts <= maxSlPts) {
        tradeDir = 1;
        entryPrice = close;
        slPrice = proposedSl;
        tp1Price = entryPrice + tp1Pts;
        tp2Price = entryPrice + tp2Pts;
        tp3Price = entryPrice + tp3Pts;
        beLocked = false;
        hitTp2 = false;
        armedDir = 0;
        firedEntryLong = true;
      }
    } else if (armedDir == -1 && close < armedLow && delta < 0.0) {
      let proposedSl = armedHigh + slBufferPts;
      let riskPts = proposedSl - close;
      if (clampSl && riskPts > maxSlPts) {
        proposedSl = close + maxSlPts;
        riskPts = maxSlPts;
      }
      if (riskPts > 0.0 && riskPts <= maxSlPts) {
        tradeDir = -1;
        entryPrice = close;
        slPrice = proposedSl;
        tp1Price = entryPrice - tp1Pts;
        tp2Price = entryPrice - tp2Pts;
        tp3Price = entryPrice - tp3Pts;
        beLocked = false;
        hitTp2 = false;
        armedDir = 0;
        firedEntryShort = true;
      }
    }
    if (armedCount >= triggerBarsMax) {
      armedDir = 0;
    }
  }

  // 3. Arm New Setup ONLY When Absorption Occurs at a Liquidity Sweep (Anti-Chop Filter)
  let newlyArmed = false;
  if (bullAbsorption && sweptLow) {
    armedDir = 1;
    armedCount = 0;
    armedHigh = high;
    armedLow = low;
    newlyArmed = true;
  } else if (bearAbsorption && sweptHigh) {
    armedDir = -1;
    armedCount = 0;
    armedHigh = high;
    armedLow = low;
    newlyArmed = true;
  }

  // Plot Distinct Entry & Exit Shapes
  out_long_entry_y(firedEntryLong ? low - 3.0 : NaN);
  out_short_entry_y(firedEntryShort ? high + 3.0 : NaN);
  out_sl_exit_y(firedSlHit ? exitMarkerPrice : NaN);
  out_be_exit_y(firedBeHit ? exitMarkerPrice : NaN);
  out_tp_exit_y(firedTpHit ? exitMarkerPrice : NaN);

  const drawLines = showHistoryLines && tradeDir != 0;
  out_entry_line(drawLines ? entryPrice : NaN);
  out_sl_line(drawLines ? slPrice : NaN);
  out_tp1_line(drawLines ? tp1Price : NaN);
  out_tp2_line(drawLines ? tp2Price : NaN);
  out_tp3_line(drawLines ? tp3Price : NaN);

  out_armed_alert(newlyArmed ? 1.0 : 0.0);
  out_entry_trigger_alert((firedEntryLong || firedEntryShort) ? 1.0 : 0.0);

  // HUD 1: Auto Session + Volatility Regime Badge
  modeText.clear();
  if (activeSessId == 1) {
    modeText.text("[ASIA");
  } else if (activeSessId == 2) {
    modeText.text("[LDN");
  } else if (activeSessId == 3) {
    modeText.text("[NY PRE");
  } else if (activeSessId == 4) {
    modeText.text("[NY AM");
  } else if (activeSessId == 5) {
    modeText.text("[LUNCH");
  } else if (activeSessId == 6) {
    modeText.text("[NY PM");
  } else {
    modeText.text("[MANUAL");
  }
  if (volRegime == 1) {
    modeText.text(" • HIGH VOL]");
  } else if (volRegime == -1) {
    modeText.text(" • LOW VOL]");
  } else {
    modeText.text(" • NORM]");
  }
  str_mode_cell_tb(modeText);

  // HUD 2: Live Delta Ratio vs Current Adaptive Hurdle
  ratioText.clear();
  if (hasBaseline) {
    ratioText.text("R ").f64(deltaRatio, 1).text("x / ").f64(minorMult, 1).text("x");
  } else {
    ratioText.text("R --");
  }
  str_ratio_cell_tb(ratioText);

  // HUD 3: Rolling Scorecard + Cumulative Net Points
  const count = histTotalCount < maxPastSetups ? histTotalCount : maxPastSetups;
  let wins: i32 = 0;
  let beWins: i32 = 0;
  let losses: i32 = 0;
  for (let i: i32 = 0; i < count; i++) {
    const shift = i64(i * 2);
    const code = i32((histMask >> shift) & 3);
    if (code == 3) {
      wins = wins + 1;
    } else if (code == 2) {
      beWins = beWins + 1;
    } else if (code == 1) {
      losses = losses + 1;
    }
  }

  scoreText.clear();
  scoreText.text("Last ").f64(f64(count), 0).text(": ")
    .f64(f64(wins), 0).text("W ")
    .f64(f64(beWins), 0).text("BE ")
    .f64(f64(losses), 0).text("L (Net ")
    .f64(cumulativeNetPts, 0).text("p)");
  str_score_cell_tb(scoreText);

  // HUD 4: Live Setup Status
  statusText.clear();
  if (!hasBaseline) {
    statusText.text("WARMUP");
  } else if (firedSlHit) {
    statusText.text("SL HIT (-1R)");
  } else if (firedBeHit) {
    statusText.text("TRAIL / BE HIT");
  } else if (firedTpHit) {
    statusText.text("TP3 HIT (+100p)");
  } else if (firedEntryLong) {
    statusText.text("LONG ENTRY");
  } else if (firedEntryShort) {
    statusText.text("SHORT ENTRY");
  } else if (tradeDir == 1) {
    statusText.text(hitTp2 ? "IN LONG (TP1 LOCK)" : (beLocked ? "IN LONG (BE LOCK)" : "IN LONG"));
  } else if (tradeDir == -1) {
    statusText.text(hitTp2 ? "IN SHORT (TP1 LOCK)" : (beLocked ? "IN SHORT (BE LOCK)" : "IN SHORT"));
  } else if (armedDir == 1) {
    statusText.text("SWEEP ARMED LONG");
  } else if (armedDir == -1) {
    statusText.text("SWEEP ARMED SHORT");
  } else {
    statusText.text("SCANNING");
  }
  str_status_cell_tb(statusText);
}
