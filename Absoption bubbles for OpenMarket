// PRIMITIVE BIT-PACKED SCORECARD REGISTERS
let histMask: i64 = 0;
let histPtsPack: i64 = 0;
let histTotalCount: i32 = 0;

let deltaBaseSma = new Sma(20);
let volBaseSma = new Sma(20);
let shortAtrSma = new Sma(14);
let pvSma = new Sma(50);
let vSma = new Sma(50);

let minorMult: f64 = 1.6;
let majorMult: f64 = 2.6;
let climaxVolMult: f64 = 1.8;
let maxBodyPct: f64 = 0.50;
let minClosePos: f64 = 0.55;

let tradeSessFilter: i32 = 0;
let filterPocChop: bool = true;
let fvDeadzoneAtr: f64 = 0.65;
let requireSwingSweep: bool = true;
let useGexWalls: bool = false;
let gexPutWall: f64 = 27673.00;
let gexTopStar: f64 = 27964.75;
let gexCallWall: f64 = 28075.50;
let gexFlipLevel: f64 = 28220.50;
let wallTolerance: f64 = 20.0;

let triggerBarsMax: i32 = 3;
let slBufferPts: f64 = 2.5;
let minSlPts: f64 = 8.0;
let maxSlPts: f64 = 25.0;
let tp1Pts: f64 = 25.0;
let tp2Pts: f64 = 60.0;
let tp3Pts: f64 = 100.0;
let maxPastSetups: i32 = 8;

let showBubbles: bool = true;
let showEntries: bool = true;
let showLines: bool = true;
let showHud: bool = true;

// TICK-SAFE CACHE & STATE
let lastBarTime: f64 = -1.0;
let lockedAvgDelta: f64 = NaN;
let lockedAvgVol: f64 = NaN;
let lockedAtr: f64 = NaN;
let lockedFairValue: f64 = NaN;

let cachedAbsDelta: f64 = 0.0;
let cachedTotalVol: f64 = 0.0;
let cachedPv: f64 = 0.0;
let cachedRange: f64 = 0.0;
let cachedHigh: f64 = NaN;
let cachedLow: f64 = NaN;

let pH1: f64 = NaN; let pH2: f64 = NaN; let pH3: f64 = NaN;
let pL1: f64 = NaN; let pL2: f64 = NaN; let pL3: f64 = NaN;

let baseArmedDir: i32 = 0; let baseArmedCount: i32 = 0;
let baseArmedHigh: f64 = 0.0; let baseArmedLow: f64 = 0.0; let baseArmedTrigger: f64 = 0.0;

let baseTradeDir: i32 = 0; let baseEntryPrice: f64 = 0.0; let baseSlPrice: f64 = 0.0;
let baseTp1Price: f64 = 0.0; let baseTp2Price: f64 = 0.0; let baseTp3Price: f64 = 0.0;
let baseBeLocked: bool = false;
let baseHistMask: i64 = 0; let baseHistPtsPack: i64 = 0; let baseHistCount: i32 = 0;

let workArmedDir: i32 = 0; let workArmedCount: i32 = 0;
let workArmedHigh: f64 = 0.0; let workArmedLow: f64 = 0.0; let workArmedTrigger: f64 = 0.0;

let workTradeDir: i32 = 0; let workEntryPrice: f64 = 0.0; let workSlPrice: f64 = 0.0;
let workTp1Price: f64 = 0.0; let workTp2Price: f64 = 0.0; let workTp3Price: f64 = 0.0;
let workBeLocked: bool = false;

let modeText = new TextBuilder(28);
let ratioText = new TextBuilder(28);
let scoreText = new TextBuilder(48);
let statusText = new TextBuilder(32);

function packOutcome(code: i64, pts: f64): void {
  histMask = (baseHistMask << 2) | (code & 3);
  let scaledPts = i64(Math.round(pts / 2.0)) + 128;
  if (scaledPts < 0) scaledPts = 0;
  else if (scaledPts > 255) scaledPts = 255;
  histPtsPack = (baseHistPtsPack << 8) | (scaledPts & 255);
  histTotalCount = baseHistCount < 8 ? baseHistCount + 1 : 8;
}

function getNyEstMinutes(timeValue: f64): i32 {
  const totalMins = timeValue > 100000000000.0 ? i64(Math.floor(timeValue / 60000.0)) : i64(Math.floor(timeValue / 60.0));
  const shifted = totalMins - 300;
  let modMins = i32(shifted % 1440);
  if (modMins < 0) modMins = modMins + 1440;
  return modMins;
}

function onStart(): void {
  const lb = i32(p_lookback());
  minorMult = p_minor_mult();
  majorMult = p_major_mult();
  climaxVolMult = p_climax_vol_mult();
  maxBodyPct = p_max_body_pct();
  minClosePos = p_min_close_pos();

  tradeSessFilter = i32(p_trade_session_filter());
  filterPocChop = pb_filter_poc_chop();
  fvDeadzoneAtr = p_fair_value_deadzone_atr();
  requireSwingSweep = pb_require_swing_sweep();
  useGexWalls = pb_use_gex_walls();
  gexPutWall = p_gex_put_wall();
  gexTopStar = p_gex_top_star();
  gexCallWall = p_gex_call_wall();
  gexFlipLevel = p_gex_flip_level();
  wallTolerance = p_wall_tolerance_pts();

  triggerBarsMax = i32(p_trigger_bars());
  slBufferPts = p_sl_buffer_pts();
  minSlPts = p_min_sl_pts();
  maxSlPts = p_max_sl_pts();
  tp1Pts = p_tp1_pts();
  tp2Pts = p_tp2_pts();
  tp3Pts = p_tp3_pts();
  maxPastSetups = i32(p_max_past_setups());

  showBubbles = pb_show_absorption_bubbles();
  showEntries = pb_show_entry_exits();
  showLines = pb_show_trade_lines();
  showHud = pb_show_hud_table();

  deltaBaseSma = new Sma(lb);
  volBaseSma = new Sma(lb);
  shortAtrSma = new Sma(14);
  pvSma = new Sma(50);
  vSma = new Sma(50);

  lastBarTime = -1.0;
  lockedAvgDelta = NaN; lockedAvgVol = NaN; lockedAtr = NaN; lockedFairValue = NaN;
  cachedAbsDelta = 0.0; cachedTotalVol = 0.0; cachedPv = 0.0; cachedRange = 0.0; cachedHigh = NaN; cachedLow = NaN;
  pH1 = NaN; pH2 = NaN; pH3 = NaN; pL1 = NaN; pL2 = NaN; pL3 = NaN;

  baseArmedDir = 0; baseArmedCount = 0; baseArmedHigh = 0.0; baseArmedLow = 0.0; baseArmedTrigger = 0.0;
  baseTradeDir = 0; baseEntryPrice = 0.0; baseSlPrice = 0.0; baseTp1Price = 0.0; baseTp2Price = 0.0; baseTp3Price = 0.0;
  baseBeLocked = false; baseHistMask = 0; baseHistPtsPack = 0; baseHistCount = 0;

  workArmedDir = 0; workArmedCount = 0; workArmedHigh = 0.0; workArmedLow = 0.0; workArmedTrigger = 0.0;
  workTradeDir = 0; workEntryPrice = 0.0; workSlPrice = 0.0; workTp1Price = 0.0; workTp2Price = 0.0; workTp3Price = 0.0;
  workBeLocked = false; histMask = 0; histPtsPack = 0; histTotalCount = 0;
}

function onBar(): void {
  const curTime = f64(bar.time());

  if (curTime != lastBarTime) {
    if (lastBarTime > 0.0) {
      lockedAvgDelta = deltaBaseSma.update(cachedAbsDelta);
      lockedAvgVol = volBaseSma.update(cachedTotalVol);
      lockedAtr = shortAtrSma.update(cachedRange);
      const avgPv = pvSma.update(cachedPv);
      const avgV = vSma.update(cachedTotalVol);
      if (!isNaN(avgPv) && !isNaN(avgV) && avgV > 0.0) lockedFairValue = avgPv / avgV;

      pH3 = pH2; pH2 = pH1; pH1 = cachedHigh;
      pL3 = pL2; pL2 = pL1; pL1 = cachedLow;

      baseArmedDir = workArmedDir; baseArmedCount = workArmedCount;
      baseArmedHigh = workArmedHigh; baseArmedLow = workArmedLow; baseArmedTrigger = workArmedTrigger;
      baseTradeDir = workTradeDir; baseEntryPrice = workEntryPrice; baseSlPrice = workSlPrice;
      baseTp1Price = workTp1Price; baseTp2Price = workTp2Price; baseTp3Price = workTp3Price;
      baseBeLocked = workBeLocked;
      baseHistMask = histMask; baseHistPtsPack = histPtsPack; baseHistCount = histTotalCount;
    }
    lastBarTime = curTime;
  }

  workArmedDir = baseArmedDir; workArmedCount = baseArmedCount;
  workArmedHigh = baseArmedHigh; workArmedLow = baseArmedLow; workArmedTrigger = baseArmedTrigger;
  workTradeDir = baseTradeDir; workEntryPrice = baseEntryPrice; workSlPrice = baseSlPrice;
  workTp1Price = baseTp1Price; workTp2Price = baseTp2Price; workTp3Price = baseTp3Price;
  workBeLocked = baseBeLocked;
  histMask = baseHistMask; histPtsPack = baseHistPtsPack; histTotalCount = baseHistCount;

  const buyVolume = in_buy();
  const sellVolume = in_sell();
  const totalVol = buyVolume + sellVolume;
  const delta = buyVolume - sellVolume;
  const absDelta = Math.abs(delta);

  const high = bar.high();
  const low = bar.low();
  const open = bar.open();
  const close = bar.close();
  const barRange = Math.max(high - low, 0.0001);

  cachedAbsDelta = absDelta; cachedTotalVol = totalVol;
  cachedPv = ((high + low + close) / 3.0) * totalVol;
  cachedRange = barRange; cachedHigh = high; cachedLow = low;

  const bodyRatio = Math.abs(close - open) / barRange;
  const bodyHigh = Math.max(open, close);
  const bodyLow = Math.min(open, close);
  const lowerWick = bodyLow - low;
  const upperWick = high - bodyHigh;

  const avgDelta = !isNaN(lockedAvgDelta) ? lockedAvgDelta : absDelta;
  const avgVol = !isNaN(lockedAvgVol) ? lockedAvgVol : totalVol;
  const shortAtr = !isNaN(lockedAtr) ? lockedAtr : barRange;

  const minBarRange = Math.max(1.25, shortAtr * 0.35);
  const hasBaseline = !isNaN(lockedAvgDelta) && lockedAvgDelta > 0.0 && !isNaN(lockedAvgVol) && lockedAvgVol > 0.0;
  const deltaRatio = hasBaseline ? absDelta / avgDelta : NaN;
  const volRatio = hasBaseline ? totalVol / avgVol : NaN;
  const rangeOk = barRange >= minBarRange;

  const compFactor = bodyRatio <= 0.30 ? 0.90 : 1.0;
  const effMinorMult = minorMult * compFactor;
  const effMajorMult = majorMult * compFactor;

  const bullWickValid = ((close - low) / barRange >= minClosePos) && (lowerWick > upperWick);
  const bearWickValid = ((high - close) / barRange >= minClosePos) && (upperWick > lowerWick);

  const bullAbsorption = hasBaseline && rangeOk && bodyRatio <= maxBodyPct && bullWickValid && (
    (delta < 0.0 && deltaRatio >= effMinorMult) || (volRatio >= climaxVolMult && (lowerWick / barRange) >= 0.50)
  );
  const bearAbsorption = hasBaseline && rangeOk && bodyRatio <= maxBodyPct && bearWickValid && (
    (delta > 0.0 && deltaRatio >= effMinorMult) || (volRatio >= climaxVolMult && (upperWick / barRange) >= 0.50)
  );

  const bullMajor = bullAbsorption && (deltaRatio >= effMajorMult || (volRatio >= climaxVolMult * 1.3));
  const bearMajor = bearAbsorption && (deltaRatio >= effMajorMult || (volRatio >= climaxVolMult * 1.3));
  const bullMinor = bullAbsorption && !bullMajor;
  const bearMinor = bearAbsorption && !bearMajor;

  // Render absorption bubbles only if showBubbles is true
  out_bull_minor(showBubbles && bullMinor ? low : NaN);
  out_bull_major(showBubbles && bullMajor ? low : NaN);
  out_bear_minor(showBubbles && bearMinor ? high : NaN);
  out_bear_major(showBubbles && bearMajor ? high : NaN);

  let minPrev3Low = pL1;
  if (!isNaN(pL2) && pL2 < minPrev3Low) minPrev3Low = pL2;
  if (!isNaN(pL3) && pL3 < minPrev3Low) minPrev3Low = pL3;

  let maxPrev3High = pH1;
  if (!isNaN(pH2) && pH2 > maxPrev3High) maxPrev3High = pH2;
  if (!isNaN(pH3) && pH3 > maxPrev3High) maxPrev3High = pH3;

  const sweepTol = shortAtr * 0.15;
  const bullSweepPass = !requireSwingSweep || isNaN(minPrev3Low) || low <= minPrev3Low + sweepTol;
  const bearSweepPass = !requireSwingSweep || isNaN(maxPrev3High) || high >= maxPrev3High - sweepTol;

  const pierceAllowance = wallTolerance * 0.35;
  const bullWallPass = !useGexWalls || (
    Math.abs(low - gexPutWall) <= wallTolerance && close >= gexPutWall - pierceAllowance ||
    Math.abs(low - gexTopStar) <= wallTolerance && close >= gexTopStar - pierceAllowance ||
    Math.abs(low - gexFlipLevel) <= wallTolerance && close >= gexFlipLevel - pierceAllowance
  );
  const bearWallPass = !useGexWalls || (
    Math.abs(high - gexCallWall) <= wallTolerance && close <= gexCallWall + pierceAllowance ||
    Math.abs(high - gexTopStar) <= wallTolerance && close <= gexTopStar + pierceAllowance ||
    Math.abs(high - gexFlipLevel) <= wallTolerance && close <= gexFlipLevel + pierceAllowance
  );

  const deadzonePts = shortAtr * fvDeadzoneAtr;
  const bullOutsidePoc = !filterPocChop || bullWallPass || isNaN(lockedFairValue) || (low <= lockedFairValue - deadzonePts);
  const bearOutsidePoc = !filterPocChop || bearWallPass || isNaN(lockedFairValue) || (high >= lockedFairValue + deadzonePts);

  const nyMins = getNyEstMinutes(curTime);
  let clockSessId: i32 = 1;
  if (nyMins >= 120 && nyMins < 570) clockSessId = 2;
  else if (nyMins >= 570 && nyMins < 690) clockSessId = 3;
  else if (nyMins >= 690 && nyMins < 810) clockSessId = 4;
  else if (nyMins >= 810 && nyMins < 1020) clockSessId = 5;

  let sessionTradeAllowed = true;
  if (tradeSessFilter == 1) sessionTradeAllowed = (clockSessId == 2 || clockSessId == 3);
  else if (tradeSessFilter == 2) sessionTradeAllowed = (clockSessId == 3);
  else if (tradeSessFilter == 3) sessionTradeAllowed = (clockSessId == 2);

  const dynSlBuffer = Math.max(slBufferPts, shortAtr * 0.20);
  const effectiveMinSl = Math.max(minSlPts, shortAtr * 0.75);
  const effectiveMaxSl = Math.max(maxSlPts, shortAtr * 2.2);

  let firedEntryLong = false;
  let firedEntryShort = false;
  let firedSlHit = false;
  let firedBeHit = false;
  let firedTpHit = false;
  let exitMarkerPrice = NaN;

  // Active Trade Management (Simplified Profitable 2-Stage Engine)
  if (workTradeDir == 1) {
    if (low <= workSlPrice) {
      exitMarkerPrice = workSlPrice;
      const realizedPts = workSlPrice - workEntryPrice;
      if (workBeLocked) {
        firedBeHit = true;
        packOutcome(2, realizedPts > 0.0 ? realizedPts : 2.0);
      } else {
        firedSlHit = true;
        packOutcome(1, realizedPts);
      }
      workTradeDir = 0;
    } else if (high >= workTp3Price) {
      exitMarkerPrice = workTp3Price;
      firedTpHit = true;
      packOutcome(3, tp3Pts);
      workTradeDir = 0;
    } else {
      if (!workBeLocked && high >= workTp1Price) {
        workSlPrice = workEntryPrice + 2.0; // Clean Breakeven + 2 pts
        workBeLocked = true;
      }
    }
  } else if (workTradeDir == -1) {
    if (high >= workSlPrice) {
      exitMarkerPrice = workSlPrice;
      const realizedPts = workEntryPrice - workSlPrice;
      if (workBeLocked) {
        firedBeHit = true;
        packOutcome(2, realizedPts > 0.0 ? realizedPts : 2.0);
      } else {
        firedSlHit = true;
        packOutcome(1, realizedPts);
      }
      workTradeDir = 0;
    } else if (low <= workTp3Price) {
      exitMarkerPrice = workTp3Price;
      firedTpHit = true;
      packOutcome(3, tp3Pts);
      workTradeDir = 0;
    } else {
      if (!workBeLocked && low <= workTp1Price) {
        workSlPrice = workEntryPrice - 2.0;
        workBeLocked = true;
      }
    }
  }

  // Armed Reclaim Entry Evaluation
  const exitedThisBar = firedSlHit || firedBeHit || firedTpHit;
  if (!exitedThisBar && workTradeDir == 0 && workArmedDir != 0 && sessionTradeAllowed) {
    workArmedCount = workArmedCount + 1;
    const longMomentumOk = delta > 0.0 || (close > workArmedHigh && close > open);
    const shortMomentumOk = delta < 0.0 || (close < workArmedLow && close < open);

    if (workArmedDir == 1 && close > workArmedTrigger && longMomentumOk) {
      let trueSl = workArmedLow - dynSlBuffer;
      let riskPts = close - trueSl;
      if (riskPts < effectiveMinSl) {
        trueSl = close - effectiveMinSl;
        riskPts = effectiveMinSl;
      }
      if (riskPts > 0.0 && riskPts <= effectiveMaxSl) {
        workTradeDir = 1;
        workEntryPrice = close;
        workSlPrice = trueSl;
        workTp1Price = workEntryPrice + tp1Pts;
        workTp2Price = workEntryPrice + tp2Pts;
        workTp3Price = workEntryPrice + tp3Pts;
        workBeLocked = false;
        workArmedDir = 0;
        firedEntryLong = true;
      }
    } else if (workArmedDir == -1 && close < workArmedTrigger && shortMomentumOk) {
      let trueSl = workArmedHigh + dynSlBuffer;
      let riskPts = trueSl - close;
      if (riskPts < effectiveMinSl) {
        trueSl = close + effectiveMinSl;
        riskPts = effectiveMinSl;
      }
      if (riskPts > 0.0 && riskPts <= effectiveMaxSl) {
        workTradeDir = -1;
        workEntryPrice = close;
        workSlPrice = trueSl;
        workTp1Price = workEntryPrice - tp1Pts;
        workTp2Price = workEntryPrice - tp2Pts;
        workTp3Price = workEntryPrice - tp3Pts;
        workBeLocked = false;
        workArmedDir = 0;
        firedEntryShort = true;
      }
    }
    if (workArmedCount >= triggerBarsMax) workArmedDir = 0;
  }

  // Arm New Setup When Flat
  let newlyArmed = false;
  if (!exitedThisBar && workTradeDir == 0 && sessionTradeAllowed) {
    if (bullAbsorption && bullSweepPass && bullWallPass && bullOutsidePoc) {
      if (workArmedDir != 1 || low <= workArmedLow) {
        workArmedDir = 1; workArmedCount = 0; workArmedHigh = high; workArmedLow = low; workArmedTrigger = bodyHigh;
        newlyArmed = true;
      }
    } else if (bearAbsorption && bearSweepPass && bearWallPass && bearOutsidePoc) {
      if (workArmedDir != -1 || high >= workArmedHigh) {
        workArmedDir = -1; workArmedCount = 0; workArmedHigh = high; workArmedLow = low; workArmedTrigger = bodyLow;
        newlyArmed = true;
      }
    }
  } else if (!sessionTradeAllowed) {
    workArmedDir = 0;
  }

  // Render entry/exit shapes and lines only if toggled ON
  out_long_entry_y(showEntries && firedEntryLong ? low - 3.0 : NaN);
  out_short_entry_y(showEntries && firedEntryShort ? high + 3.0 : NaN);
  out_sl_exit_y(showEntries && firedSlHit ? exitMarkerPrice : NaN);
  out_be_exit_y(showEntries && firedBeHit ? exitMarkerPrice : NaN);
  out_tp_exit_y(showEntries && firedTpHit ? exitMarkerPrice : NaN);

  const drawLines = showLines && workTradeDir != 0;
  out_entry_line(drawLines ? workEntryPrice : NaN);
  out_sl_line(drawLines ? workSlPrice : NaN);
  out_tp1_line(drawLines ? workTp1Price : NaN);
  out_tp2_line(drawLines ? workTp2Price : NaN);
  out_tp3_line(drawLines ? workTp3Price : NaN);

  out_armed_alert(newlyArmed ? 1.0 : 0.0);
  out_entry_trigger_alert((firedEntryLong || firedEntryShort) ? 1.0 : 0.0);

  // HUD and Status (Rendered only if showHud is true)
  modeText.clear();
  if (showHud) {
    if (clockSessId == 1) modeText.text("[ASIA ");
    else if (clockSessId == 2) modeText.text("[LDN ");
    else if (clockSessId == 3) modeText.text("[NY AM ");
    else if (clockSessId == 4) modeText.text("[LUNCH ");
    else modeText.text("[NY PM ");
    if (!isNaN(lockedAtr)) modeText.text("ATR ").f64(lockedAtr, 1).text("p]");
    else modeText.text("ATR --]");
  } else {
    modeText.text("");
  }
  str_mode_cell_tb(modeText);

  ratioText.clear();
  if (showHud && hasBaseline) ratioText.text("D ").f64(deltaRatio, 1).text("x • V ").f64(volRatio, 1).text("x");
  else ratioText.text("");
  str_ratio_cell_tb(ratioText);

  const count = histTotalCount < maxPastSetups ? histTotalCount : maxPastSetups;
  let wins: i32 = 0; let beWins: i32 = 0; let losses: i32 = 0; let rollingPts: f64 = 0.0;
  for (let i: i32 = 0; i < count; i++) {
    const shift2 = i64(i * 2);
    const code = i32((histMask >> shift2) & 3);
    if (code == 3) wins = wins + 1;
    else if (code == 2) beWins = beWins + 1;
    else if (code == 1) losses = losses + 1;

    const shift8 = i64(i * 8);
    const rawByte = i32((histPtsPack >> shift8) & 255);
    rollingPts = rollingPts + (f64(rawByte - 128) * 2.0);
  }

  scoreText.clear();
  if (showHud) {
    scoreText.text("Last ").f64(f64(count), 0).text(": ").f64(f64(wins), 0).text("W ").f64(f64(beWins), 0).text("BE ").f64(f64(losses), 0).text("L (").f64(rollingPts, 0).text("p)");
  } else {
    scoreText.text("");
  }
  str_score_cell_tb(scoreText);

  statusText.clear();
  if (showHud) {
    if (!hasBaseline) statusText.text("WARMUP");
    else if (!sessionTradeAllowed && workTradeDir == 0) statusText.text("PAUSED (OFF-SESSION)");
    else if (firedSlHit) statusText.text("SL HIT (-1R)");
    else if (firedBeHit) statusText.text("BE STOP HIT");
    else if (firedTpHit) statusText.text("TP3 RUNNER HIT");
    else if (workTradeDir == 1) statusText.text(workBeLocked ? "IN LONG (BE+2)" : "IN LONG");
    else if (workTradeDir == -1) statusText.text(workBeLocked ? "IN SHORT (BE+2)" : "IN SHORT");
    else statusText.text("SCANNING");
  } else {
    statusText.text("");
  }
  str_status_cell_tb(statusText);
}
